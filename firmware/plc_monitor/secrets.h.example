/*
 * secrets.h.example
 * ─────────────────
 * Copy this file to secrets.h and fill in your real values.
 * secrets.h is in .gitignore and must NEVER be committed to the repository.
 *
 * For HiveMQ Cloud (free tier):
 *   1. Create account at https://console.hivemq.cloud
 *   2. Create a cluster → note the hostname
 *   3. Create credentials (user + password) under "Access Management"
 *   4. Enable WebSocket (port 8884 WSS) for browser access
 *   5. The MQTT_PORT for the ESP8266 is 8883 (native TLS, not WebSocket)
 */

#ifndef SECRETS_H
#define SECRETS_H

// ─── Wi-Fi ────────────────────────────────────────────────────────────────────
#define WIFI_SSID       "your_wifi_ssid_here"
#define WIFI_PASSWORD   "your_wifi_password_here"

// ─── MQTT broker ──────────────────────────────────────────────────────────────
// HiveMQ Cloud example: "xxxxxxxxxxxxxxxx.s1.eu.hivemq.cloud"
#define MQTT_HOST       "your_broker_hostname_here"
#define MQTT_PORT       8883          // native MQTT over TLS

// Credentials with PUBLISH-only permission on plcmon/# topics.
// The browser uses separate READ-ONLY credentials.
#define MQTT_USER       "esp8266_device_user"
#define MQTT_PASS       "your_device_password_here"

// Unique client ID – change if you run multiple ESP8266 devices
#define MQTT_CLIENT_ID  "nodemcu-plc-01"

#endif // SECRETS_H
