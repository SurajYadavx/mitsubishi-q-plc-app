/*
 * secrets.h.example
 * ─────────────────
 * Copy this file to secrets.h and fill in your real values.
 * secrets.h is in .gitignore and must NEVER be committed to the repository.
 *
 * For EMQX Cloud Serverless:
 *   1. Create an EMQX Cloud deployment (https://cloud.emqx.com).
 *   2. Copy the broker deployment hostname (e.g., "xxxxxx.emqxsl.com").
 *   3. Under Authentication, create device credentials (user + password).
 *      Approved username for the device publisher is: "plc_monitor_device"
 *   4. Under Authorization (ACL), assign "plc_monitor_device" Publish-only
 *      permission on "plcmon/#".
 *   5. For the browser web console, create a separate read-only user
 *      ("browser_readonly") with Subscribe-only permission on "plcmon/#".
 *   6. The MQTT_PORT for the ESP8266 is 8883 (native MQTT over TLS).
 *      (The web browser connects via Secure WebSockets WSS on port 8084 with path /mqtt).
 */

#ifndef SECRETS_H
#define SECRETS_H

// ─── Wi-Fi ────────────────────────────────────────────────────────────────────
#define WIFI_SSID       "your_wifi_ssid_here"
#define WIFI_PASSWORD   "your_wifi_password_here"

// ─── MQTT broker ──────────────────────────────────────────────────────────────
// EMQX Cloud Serverless hostname example: "xxxxxx.emqxsl.com"
#define MQTT_HOST       "your_broker_hostname_here"
#define MQTT_PORT       8883          // native MQTT over TLS (port 8883)

// Device publisher credentials with PUBLISH-only permission on plcmon/# topics.
// The browser dashboard uses separate READ-ONLY credentials (browser_readonly).
#define MQTT_USER       "plc_monitor_device"
#define MQTT_PASS       "your_device_password_here"

// Unique client ID – change if you run multiple ESP8266 devices
#define MQTT_CLIENT_ID  "nodemcu-plc-01"

// ─── NTP Server Configuration (Time Sync for TLS Certificate Validation) ──────
// The ESP8266 requires accurate time to validate TLS certificate validity periods.
// In isolated/air-gapped industrial cells, override these with your local plant
// NTP server IP (e.g. gateway laptop or local router IP).
#define NTP_SERVER_1    "pool.ntp.org"
#define NTP_SERVER_2    "time.nist.gov"
#define NTP_SERVER_3    "time.google.com"

#endif // SECRETS_H

